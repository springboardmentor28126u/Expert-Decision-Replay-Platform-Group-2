ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://edrp_user:edrp_password@localhost:5432/edrp_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# true for external Postgres (Neon requires TLS). docker-compose.yml
# sets this to false for the local Postgres container, which doesn't
# speak TLS — no need to change it here for that case.
DB_SSL_REQUIRE=true

SECRET_KEY=replace-this-with-a-generated-64-char-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

BACKEND_CORS_ORIGINS=http://localhost:3000

# Optional — enables Gemini-backed decision summarization / NL query.
# Leave blank to fall back to deterministic (non-LLM) behavior.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Optional — automatic fallback provider, tried only when Gemini is
# rate-limited, unconfigured, or fails. Leave GROQ_API_KEY blank to
# skip Groq entirely; Gemini-only behavior is unaffected either way.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional — enables email alerts for approval changes and new comments.
# Leave SMTP_HOST/SMTP_FROM_EMAIL blank to disable email sending; the
# app logs a warning and continues functioning normally without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Base URL used to build the "view decision" link in emails.
FRONTEND_BASE_URL=http://localhost:5173

# Optional — enables shared/distributed rate limiting across multiple
# backend processes via Redis (atomic sliding-window). Leave blank to
# fall back to in-memory (per-process) rate limiting, which remains
# fully functional on its own — this is purely an upgrade for running
# more than one backend process/replica.
REDIS_URL=