# ==============================================================================
# EDRP – Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==============================================================================

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=edrp
POSTGRES_USER=edrp_user
POSTGRES_PASSWORD=change_me_strong_password

# ── JWT / Auth ─────────────────────────────────────────────────────────────────
SECRET_KEY=replace_with_a_long_random_secret_key_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Redis ──────────────────────────────────────────────────────────────────────
# Constructed automatically from service name in docker-compose.
# Override only if using an external Redis instance:
# REDIS_URL=redis://redis:6379/0

# ── SMTP (Gmail App Password) ──────────────────────────────────────────────────
SMTP_EMAIL=yourapp@gmail.com
SMTP_APP_PASSWORD=your_16char_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── Flask Frontend ─────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=replace_with_another_long_random_string

# ── Port Overrides (optional) ──────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5000

# ── Misc ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
# Comma-separated origins the backend allows (for CORS)
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:8000
